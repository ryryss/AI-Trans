{
  "manifest_version": 3,
  "name": "AI-Trans",
  "version": "1.2.1",
  "description": "Open-source AI translation for Chrome. Bring your own API key from mainstream AI providers or self-hosted endpoints. In-place page translation that preserves layout — no bloat, no tracking.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI-Trans",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Translate / restore current page"
    }
  }
}
